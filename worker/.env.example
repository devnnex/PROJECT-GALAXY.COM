# DEPLOYMENT TEMPLATE ONLY. Never commit real values to this file.
# Create these names in the hosting provider's Environment/Secrets panel.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-backend-only-sb-secret-key
TRADING_ECONOMICS_CLIENT_KEY=your-client-key
TRADING_ECONOMICS_CLIENT_SECRET=your-client-secret

# Optional reliability tuning
MACRO_AGGREGATION_WINDOW_MS=350
MACRO_LATE_UPDATE_WINDOW_MS=3000
MACRO_STALE_AFTER_MS=130000
MACRO_REST_SYNC_INTERVAL_MS=300000
MACRO_CONNECTION_TIMEOUT_MS=20000
