function getWallet_(context){var found=findRecord_('Wallets','userId',context.user.id);if(!found)throw apiError_('WALLET_NOT_FOUND','No encontramos tu wallet.',404);return{id:found.data.id,available:Number(found.data.availableBalance),pending:Number(found.data.pendingBalance),totalEarned:Number(found.data.totalEarned),totalSpent:Number(found.data.totalSpent),currency:found.data.currency,transactions:listRecords_('Transactions').filter(function(t){return t.userId===context.user.id;}).slice(-100).reverse()};}
function settleCommission_(order){var commission=findRecord_('Commissions','orderId',order.id);if(!commission||commission.data.status==='SETTLED')return;var wallet=findRecord_('Wallets','userId',order.sellerId);if(!wallet)throw new Error('Seller wallet missing');updateRecord_('Wallets',wallet.rowNumber,{availableBalance:roundMoney_(Number(wallet.data.availableBalance)+Number(commission.data.sellerAmount)),totalEarned:roundMoney_(Number(wallet.data.totalEarned)+Number(commission.data.sellerAmount)),updatedAt:nowIso_()});updateRecord_('Commissions',commission.rowNumber,{status:'SETTLED'});}

