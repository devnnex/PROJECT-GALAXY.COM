function updateSetting_(context,key,value){requireAdmin_(context);var allowed=['APP_NAME','REGISTRATION_ENABLED','MARKETPLACE_ENABLED','MEETINGS_ENABLED','STREAMING_ENABLED','MAINTENANCE_MODE','COMMISSION_RATE','PAYMENT_EXPIRATION_MINUTES','TRC20_ENABLED','ERC20_ENABLED','MINIMUM_WITHDRAWAL'];if(allowed.indexOf(key)<0)throw apiError_('SETTING_NOT_ALLOWED','Esta opción no puede modificarse desde el panel.',403);var found=findRecord_('Settings','key',key);if(!found)throw apiError_('SETTING_NOT_FOUND','No encontramos esta opción.',404);var updated=updateRecord_('Settings',found.rowNumber,{value:String(value),updatedBy:context.user.id,updatedAt:nowIso_()});CacheService.getScriptCache().remove('settings:all');logSecurityEvent_(context.user.id,'SETTING_CHANGED','WARNING','Setting',key,{value:String(value)});return updated;}
